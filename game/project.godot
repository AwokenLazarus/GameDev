; Engine configuration file.
; Moonwake V0 — Godot 4.3

config_version=5

[application]

config/name="Moonwake"
config/description="Gothic frontier action roguelite — V0 vertical slice"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
RunState="*res://autoload/run_state.gd"
CharacterDB="*res://autoload/character_db.gd"
SectorDB="*res://autoload/sector_db.gd"
MetaDB="*res://autoload/meta_db.gd"
BoonDB="*res://autoload/boon_db.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

